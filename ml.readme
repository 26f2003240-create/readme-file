    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "\n",
        "# Define the columns and rows\n",
        "data = {\n",
        "    'Name': ['Alice', 'Bob', 'Charlie'],\n",
        "    'Age': [25,30,21] ,\n",
        "    'City': ['New York', 'London', 'Paris']\n",
        "}\n",
        "\n",
        "# Create the table (DataFrame)\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "print(df)\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "Bt6NyaXhp0Hz",
